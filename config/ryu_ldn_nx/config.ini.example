; ryu_ldn_nx Configuration
; Auto-generated on first boot
; Edit this file to customize settings

[server]
; Relay hostname (empty = do not connect)
host =
; Server port
port = 443
; Secure WebSocket transport (plain TCP is refused)
transport = wss
; WebSocket path on the relay
path = /ldn
; Console id sent as X-Console-Id (a-z, 0-9, '-', 1-32 characters)
console_id =
; Secret: 64 hex characters, one per console. Never share it.
token =
; Trust anchors (PEM, at most 64 KB) used to verify the relay certificate
ca_file = sdmc:/config/ryu_ldn_nx/ca.pem
; WARNING: transport = wss keeps disable_p2p = 1 (P2P cannot be enabled)

[ldn]
; Enable LDN emulation (0/1/true/false/yes/no)
enabled = 1
; Enable passphrase filtering (0/1)
use_passphrase = 0
; Room passphrase (empty = public)
passphrase =
; Disable P2P proxy (0 = P2P enabled, 1 = P2P disabled / relay-only)
; WARNING: Setting to 0 enables P2P proxy which is experimental and incomplete.
; Keep at 1 (relay-only) for stable gameplay.
disable_p2p = 1
; Hold this button while launching a game (from the HOME menu, until the
; game starts loading) to give that launch real local wireless instead of
; the server. Holding it later, once the game is running, does nothing.
; Names: A B X Y L R ZL ZR PLUS MINUS LSTICK RSTICK DLEFT DUP DRIGHT DDOWN
; (case-insensitive). Join with + for a combo that must all be held, e.g.
; ZL+ZR. none = no button.
; Avoid L and R: Atmosphere also reads them at launch (holding L starts the
; game without mods/cheats, holding R opens the homebrew menu instead).
real_wireless_button = ZR

[debug]
; Enable debug logging (0/1/true/false/yes/no)
; When enabled, logs are written to both console and SD card file.
enabled = 0
; Log level (0=errors, 1=warnings, 2=info, 3=verbose)
level = 1
